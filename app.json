{
  "expo": {
    "name": "R3CC",
    "slug": "r3cc",
    "scheme": "r3cc",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "R3CC records your rides when you choose to start tracking."
        }
      ],
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.r3cc.members"
    },
    "android": {
      "package": "app.r3cc.members",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
